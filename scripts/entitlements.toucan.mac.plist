<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <dict>
    <!--
      Entitlements for the toucan-camera-server binary (only used for a
      Developer ID + hardened runtime signature; ignored for ad-hoc signing).

      disable-library-validation is required: the binary loads many prebuilt
      third-party libraries (Canon's EDSDK.framework, Sony's CrAdapter dylibs,
      Nikon's Royalmile.framework / libNkPTPDriver2, the libgphoto2 plugins, ...),
      each signed by a different Team ID than ours. Without this entitlement, the
      hardened runtime's library validation would refuse to load them.
    -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <key>com.apple.security.device.camera</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
  </dict>
</plist>
